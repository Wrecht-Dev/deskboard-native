<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Deskboard.App.ViewModels"
        xmlns:controls="using:Deskboard.App.Controls"
        xmlns:conv="using:Deskboard.App.Converters"
        x:Class="Deskboard.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Deskboard — Tumblr"
        Width="1400" Height="920" MinWidth="900" MinHeight="620"
        Background="{DynamicResource PageBrush}">
  <Window.Resources>
    <conv:BoolToAlignmentConverter x:Key="AlignConverter" />
  </Window.Resources>
  <Grid ColumnDefinitions="232,*,324">

    <!-- left rail -->
    <Border Grid.Column="0" Background="{DynamicResource RailBrush}">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,20,0,16">
        <TextBlock Grid.Row="0" Text="tumblr" FontSize="30" FontWeight="Black"
                   Foreground="{DynamicResource TextBrush}" Margin="28,0,0,18" />
        <TextBox Grid.Row="1" Name="SearchBox" Watermark="Search Tumblr" Margin="18,0,18,10"
                 FontSize="13" KeyDown="OnSearchKey" />
        <ListBox Grid.Row="2" Classes="nav" ItemsSource="{Binding Feeds}"
                 SelectedItem="{Binding SelectedFeed}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:FeedOption">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="4" Spacing="10" Margin="20,0">
          <TextBlock Text="{Binding Identity}" Classes="dim" FontSize="12" />
          <Button Classes="accent" Content="Create" HorizontalAlignment="Stretch" Click="OnCreate" />
          <Button Content="Settings" Click="OnSettings" FontSize="12" HorizontalAlignment="Stretch" />
          <TextBlock Text="native rewrite · .NET + Avalonia" Classes="dim" FontSize="10" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- centre -->
    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Top" Padding="34,20,34,12">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button Grid.Column="0" Content="‹" FontSize="22" Padding="10,0" Background="Transparent"
                  Foreground="#9AA7B4" IsVisible="{Binding CanGoBack}"
                  Command="{Binding GoBackCommand}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="2" Margin="8,0,0,0">
            <TextBlock Text="{Binding Headline}" Classes="title" />
            <TextBlock Text="{Binding Subhead}" Classes="dim" FontSize="13" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                      IsVisible="{Binding IsBlogPage}" VerticalAlignment="Center">
            <TextBlock Text="{Binding BlogFollowersLabel}" Classes="dim" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,6,0" />
            <Button Content="Ask" Click="OnAsk" IsVisible="{Binding CanAsk}" />
            <Button Content="Follow" Classes="accent" Click="OnFollow"
                    IsVisible="{Binding !IsFollowing}" />
            <Button Content="Following" Click="OnFollow" IsVisible="{Binding IsFollowing}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                      IsVisible="{Binding IsTagPage}" VerticalAlignment="Center">
            <Button Content="Latest" Classes="chip" FontSize="13" Padding="12,5"
                    Command="{Binding SetTagSortCommand}" CommandParameter="latest" />
            <Button Content="Top" Classes="chip" FontSize="13" Padding="12,5"
                    Command="{Binding SetTagSortCommand}" CommandParameter="top" />
          </StackPanel>
        </Grid>
      </Border>

      <Border DockPanel.Dock="Top" Margin="34,0,34,8" IsVisible="{Binding IsLibraryPage}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="Inbox" Classes="chip" FontSize="13" Command="{Binding SetLibraryCommand}" CommandParameter="inbox" />
          <Button Content="Drafts" Classes="chip" FontSize="13" Command="{Binding SetLibraryCommand}" CommandParameter="drafts" />
          <Button Content="Queue" Classes="chip" FontSize="13" Command="{Binding SetLibraryCommand}" CommandParameter="queue" />
        </StackPanel>
      </Border>

      <Border DockPanel.Dock="Bottom" Padding="34,10" IsVisible="{Binding HasStatus}">
        <TextBlock Text="{Binding Status}" Classes="dim" FontSize="13" />
      </Border>

      <Border DockPanel.Dock="Top" Margin="34,0,34,10" IsVisible="{Binding HasSearchMeta}">
        <StackPanel Spacing="6">
          <TextBlock Text="Blogs" Classes="dim" FontSize="11" />
          <ItemsControl ItemsSource="{Binding SearchBlogs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BlogRowViewModel">
                <Button Command="{Binding OpenCommand}" Background="#1B1B1B" CornerRadius="8"
                        Padding="8" Margin="0,0,8,8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Width="28" Height="28" CornerRadius="14" ClipToBounds="True" Background="#25323D">
                      <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Handle}" Classes="dim" FontSize="11" />
                    </StackPanel>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Grid>
        <ListBox Name="FeedList" Classes="feed" ItemsSource="{Binding Posts}"
                 IsVisible="{Binding ShowFeed}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 DoubleTapped="OnOpenPost">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PostItemViewModel">
              <Border Classes="card" Margin="0,0,0,14" MaxWidth="640">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Width="40" Height="40" CornerRadius="20" ClipToBounds="True"
                            Background="#25323D" VerticalAlignment="Top">
                      <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="1">
                      <Button Content="{Binding BlogName}" Command="{Binding OpenBlogCommand}"
                              Background="Transparent" Padding="0" HorizontalAlignment="Left"
                              FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextBrush}" />
                      <TextBlock Text="{Binding Handle}" Classes="dim" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="{Binding TimeAgo}" Classes="dim" FontSize="12" VerticalAlignment="Center" />
                      <Button Content="⋯" Background="Transparent" Padding="6,0" FontSize="16"
                              Foreground="#9AA7B4" VerticalAlignment="Center">
                        <Button.Flyout>
                          <MenuFlyout>
                            <MenuItem Header="Mute post" Click="OnMutePost" />
                            <MenuItem Header="Block blog" Click="OnBlockBlog" />
                            <MenuItem Header="Report post" Click="OnReportPost" />
                            <Separator />
                            <MenuItem Header="Delete post" Click="OnDeletePost" />
                          </MenuFlyout>
                        </Button.Flyout>
                      </Button>
                    </StackPanel>
                  </Grid>
  
                  <TextBlock Text="{Binding RebloggedFrom}" Classes="dim" FontSize="12"
                             IsVisible="{Binding HasReblogLabel}" />
                  <controls:PostBody Paragraphs="{Binding Paragraphs}" IsVisible="{Binding HasBody}" />
  
                  <Border IsVisible="{Binding SingleMedia}" CornerRadius="8" ClipToBounds="True" Background="#0F0F0F">
                    <Grid>
                      <Image Source="{Binding Media[0].Bitmap}" Stretch="Uniform"
                             MaxHeight="{Binding Media[0].Height}" />
                      <Border Background="#CC000000" CornerRadius="4" Padding="8,4" Margin="10"
                              HorizontalAlignment="Left" VerticalAlignment="Bottom"
                              IsVisible="{Binding Media[0].HasBadge}">
                        <TextBlock Text="{Binding Media[0].Badge}" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                      </Border>
                    </Grid>
                  </Border>
  
                  <ItemsControl ItemsSource="{Binding Media}" IsVisible="{Binding MultipleMedia}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MediaItemViewModel">
                        <Border CornerRadius="6" ClipToBounds="True" Margin="0,0,4,4" Background="#0F0F0F">
                          <Image Source="{Binding Bitmap}" Stretch="UniformToFill" Height="{Binding Height}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
  
                  <TextBlock Text="{Binding TagsText}" Classes="tag" FontSize="13" IsVisible="{Binding HasTags}" />
  
                  <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="0,4,0,0">
                    <Button Grid.Column="0" Classes="actionlike" Command="{Binding ToggleLikeCommand}"
                            Background="Transparent" Padding="2,0" FontSize="17" Foreground="#9AA7B4">
                      <TextBlock Text="{Binding LikeGlyph}" Foreground="#9AA7B4" FontSize="17" />
                    </Button>
                    <TextBlock Grid.Column="1" Text="{Binding LikeCountLabel}" Classes="dim" FontSize="13"
                               Margin="5,3,16,0" />
                    <Button Grid.Column="2" Background="Transparent" Padding="2,0" Click="OnReblog"
                            VerticalAlignment="Center">
                      <TextBlock Text="⇄" FontSize="15" Foreground="#9AA7B4" />
                    </Button>
                    <TextBlock Grid.Column="3" Text="{Binding ReblogLabel}" Classes="dim" FontSize="13" Margin="5,3,0,0" />
                    <TextBlock Grid.Column="5" Text="{Binding NotesLabel}" Classes="dim" FontSize="13"
                               VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
  
        <ScrollViewer IsVisible="{Binding IsNotificationsPage}" Padding="34,0,34,24">
          <StackPanel Spacing="2" MaxWidth="640">
            <ItemsControl ItemsSource="{Binding Notifications}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NotificationItemViewModel">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,4" Height="54">
                    <Border Width="34" Height="34" CornerRadius="17" ClipToBounds="True" Background="#25323D"
                            VerticalAlignment="Center">
                      <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" />
                      <TextBlock Text="{Binding Action}" Classes="dim" FontSize="12" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding TimeAgo}" Classes="dim" FontSize="12"
                               Margin="0,0,10,0" VerticalAlignment="Center" />
                    <Button Grid.Column="3" Content="Follow back" FontSize="12" Padding="10,5"
                            IsVisible="{Binding NeedsFollowBack}" Command="{Binding FollowBackCommand}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
  
        <!-- conversations list -->
        <ScrollViewer IsVisible="{Binding IsMessagesPage}" Padding="34,0,34,24">
          <StackPanel Spacing="2" MaxWidth="640">
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding InThread}" Margin="0,0,0,10">
              <Button Content="‹ Back" Command="{Binding BackToConversationsCommand}" />
              <TextBlock Text="{Binding ThreadTitle}" Classes="heading" VerticalAlignment="Center" />
            </StackPanel>
  
            <ItemsControl ItemsSource="{Binding Conversations}" IsVisible="{Binding !InThread}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ConversationItemViewModel">
                  <Button Command="{Binding OpenCommand}" Background="Transparent" Padding="8"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Width="44" Height="44" CornerRadius="22" Background="#25323D">
                        <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontSize="17" FontWeight="Bold" />
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{Binding Preview}" Classes="dim" FontSize="12"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="{Binding UpdatedLabel}" Classes="dim" FontSize="11"
                                   HorizontalAlignment="Right" />
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="6,1"
                                IsVisible="{Binding HasUnread}" HorizontalAlignment="Right">
                          <TextBlock Text="{Binding Conversation.Unread}" FontSize="10" Foreground="#001935" />
                        </Border>
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
  
            <ScrollViewer IsVisible="{Binding InThread}" Height="600">
              <ItemsControl ItemsSource="{Binding ThreadMessages}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MessageItemViewModel">
                    <Border Classes="card" Padding="12" Margin="0,0,0,8"
                            HorizontalAlignment="{Binding IsMine, Converter={StaticResource AlignConverter}}">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Author}" Classes="dim" FontSize="11" />
                        <TextBlock Text="{Binding Text}" FontSize="14" />
                        <TextBlock Text="{Binding TimeLabel}" Classes="dim" FontSize="10" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
  
            <Grid IsVisible="{Binding InThread}" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,10,0,0">
              <TextBox Grid.Column="0" Text="{Binding ComposerText}" Watermark="Write a message…" />
              <Button Grid.Column="1" Classes="accent" Content="Send"
                      Command="{Binding SendMessageCommand}" IsEnabled="{Binding !IsSending}" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </DockPanel>

    <!-- right rail -->
    <Border Grid.Column="2" Background="{DynamicResource RailBrush}" Padding="22">
      <StackPanel Spacing="16">
        <Border Classes="card" Padding="18">
          <StackPanel Spacing="10">
            <TextBlock Text="#art" FontSize="26" FontWeight="Bold" />
            <TextBlock Text="Art is different for everyone, but what stays universal is versatility, beauty, and a fearlessness to try something new"
                       Classes="dim" FontSize="13" />
            <TextBlock Text="39M followers / 8.1K recent posts" Classes="dim" FontSize="12" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <Button Grid.Column="0" Classes="accent" Content="Follow" HorizontalAlignment="Stretch" />
              <Button Grid.Column="1" Content="New post" HorizontalAlignment="Stretch" />
            </Grid>
          </StackPanel>
        </Border>
        <WrapPanel Orientation="Horizontal">
          <Button Classes="chip" Content="#art" Margin="0,0,6,6" />
          <Button Classes="chip" Content="#photography" Margin="0,0,6,6" />
          <Button Classes="chip" Content="#design" Margin="0,0,6,6" />
          <Button Classes="chip" Content="#typography" Margin="0,0,6,6" />
        </WrapPanel>
        <Button Content="Load more" Command="{Binding LoadMoreCommand}" IsVisible="{Binding HasMore}"
                HorizontalAlignment="Stretch" />
        <TextBlock Text="Scaffold: read-only feed. Write actions, media playback, DMs and composer land in the next rounds."
                   Classes="dim" FontSize="11" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
