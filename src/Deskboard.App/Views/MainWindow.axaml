<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Deskboard.App.ViewModels"
        xmlns:controls="using:Deskboard.App.Controls"
        xmlns:conv="using:Deskboard.App.Converters"
        x:Class="Deskboard.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Deskboard — Tumblr"
        Width="1400" Height="920" MinWidth="900" MinHeight="620"
        Background="{DynamicResource PageBrush}">
  <Window.Resources>
    <conv:BoolToAlignmentConverter x:Key="AlignConverter" />
  </Window.Resources>
  <Grid Name="Workspace" ColumnDefinitions="216,*,260">

    <!-- left rail -->
    <Border Grid.Column="0" Background="{DynamicResource RailBrush}">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,20,0,16">
        <TextBlock Grid.Row="0" Text="Deskboard" FontSize="30" FontWeight="Black"
                   Foreground="{DynamicResource TextBrush}" Margin="28,0,0,18" />
        <TextBox Grid.Row="1" Name="SearchBox" AutomationProperties.Name="Search Tumblr" PlaceholderText="Search Tumblr" Margin="18,0,18,10"
                 FontSize="13" KeyDown="OnSearchKey" />
        <ListBox Grid.Row="2" Classes="nav" ItemsSource="{Binding Feeds}"
                 SelectedItem="{Binding SelectedFeed}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:FeedOption">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Grid.Row="3" Margin="10,8,10,12">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="8,0,4,2">
            <TextBlock Text="PINNED" Classes="dim" FontSize="10" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Add" AutomationProperties.Name="Pin a feed" FontSize="13" Padding="7,0" Background="Transparent"
                    Foreground="{DynamicResource DimBrush}" Click="OnAddPinned" ToolTip.Tip="Pin a tab" />
          </Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding PinnedTabs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Click="OnPinnedTab" Background="Transparent" Padding="10,6"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding SortLabel}" Classes="dim"
                               FontSize="10" VerticalAlignment="Center" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </ScrollViewer>
        </DockPanel>

        <StackPanel Grid.Row="4" Spacing="10" Margin="20,0">
          <TextBlock Text="{Binding Identity}" Classes="dim" FontSize="12" />
          <Button Classes="accent" Content="Create" HorizontalAlignment="Stretch" Click="OnCreate"
                  IsVisible="{Binding IsSignedIn}" />
          <Button Classes="accent" Content="Sign in" HorizontalAlignment="Stretch" Click="OnSignIn"
                  IsVisible="{Binding !IsSignedIn}" />
          <Button Content="{Binding UpdateLabel}" Command="{Binding OpenUpdateCommand}"
                  IsVisible="{Binding HasUpdate}" Classes="accent" FontSize="12"
                  HorizontalAlignment="Stretch" />
          <Button Content="Settings" Click="OnSettings" FontSize="12" HorizontalAlignment="Stretch" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- centre -->
    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Top" Padding="34,20,34,12">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button Grid.Column="0" Content="‹" FontSize="22" Padding="10,0" Background="Transparent"
                  Foreground="#9AA7B4" IsVisible="{Binding CanGoBack}"
                  Command="{Binding GoBackCommand}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="2" Margin="8,0,0,0">
            <TextBlock Text="{Binding Headline}" Classes="title" />
            <TextBlock Text="{Binding Subhead}" Classes="dim" FontSize="13" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                      IsVisible="{Binding IsBlogPage}" VerticalAlignment="Center">
            <TextBlock Text="{Binding BlogFollowersLabel}" Classes="dim" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,6,0" />
            <Button Content="Ask" Click="OnAsk" IsVisible="{Binding CanAsk}" />
            <Button Content="Submit" Click="OnSubmitPost" IsVisible="{Binding CanSubmitBlog}" />
            <Button Content="Follow" Classes="accent" Click="OnFollow"
                    IsVisible="{Binding !IsFollowing}" />
            <Button Content="Following" Click="OnFollow" IsVisible="{Binding IsFollowing}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                      IsVisible="{Binding IsPinnedTab}" VerticalAlignment="Center">
            <Button Content="Latest" Classes="chip" FontSize="13" Padding="12,5"
                    IsVisible="{Binding CanSortPinnedTab}" Classes.selected="{Binding IsPinnedLatest}" Command="{Binding SetPinnedSortCommand}" CommandParameter="latest" />
            <Button Content="Top" Classes="chip" FontSize="13" Padding="12,5"
                    IsVisible="{Binding CanSortPinnedTab}" Classes.selected="{Binding IsPinnedTop}" Command="{Binding SetPinnedSortCommand}" CommandParameter="top" />
            <Button Content="Unpin" Command="{Binding RemoveActivePinnedCommand}" FontSize="12" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                      IsVisible="{Binding IsTagPage}" VerticalAlignment="Center">
            <Button Content="Latest" Classes="chip" FontSize="13" Padding="12,5"
                    Classes.selected="{Binding IsLatest}" Command="{Binding SetTagSortCommand}" CommandParameter="latest" />
            <Button Content="Top" Classes="chip" FontSize="13" Padding="12,5"
                    Classes.selected="{Binding IsTop}" Command="{Binding SetTagSortCommand}" CommandParameter="top" />
            <Button Content="Pin tag" Click="OnPinCurrentFeed" />
          </StackPanel>
          <Button Grid.Column="2" Content="Pin search" Click="OnPinCurrentFeed"
                  IsVisible="{Binding IsSearchPage}" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Border DockPanel.Dock="Top" Margin="34,0,34,8" IsVisible="{Binding IsQueueView}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="Pause queue" FontSize="12" Command="{Binding PauseQueueCommand}" />
          <Button Content="Resume queue" FontSize="12" Command="{Binding ResumeQueueCommand}" />
          <Button Content="Shuffle" FontSize="12" Command="{Binding ShuffleQueueCommand}" />
        </StackPanel>
      </Border>

      <Border DockPanel.Dock="Top" Margin="34,0,34,8" IsVisible="{Binding HasHiddenPosts}">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
          <TextBlock Text="{Binding FilterNote}" Classes="dim" FontSize="12" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Show hidden" FontSize="12" Padding="10,4"
                  Command="{Binding ShowFilteredCommand}" />
          <Button Grid.Column="2" Content="Filter settings" FontSize="12" Click="OnFilterSettings" />
        </Grid>
      </Border>

      <Border DockPanel.Dock="Top" Margin="34,0,34,8" IsVisible="{Binding IsLibraryPage}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="Inbox" Classes="chip" FontSize="13" Command="{Binding SetLibraryCommand}" CommandParameter="inbox" />
          <Button Content="Drafts" Classes="chip" FontSize="13" Command="{Binding SetLibraryCommand}" CommandParameter="drafts" />
          <Button Content="Queue" Classes="chip" FontSize="13" Command="{Binding SetLibraryCommand}" CommandParameter="queue" />
        </StackPanel>
      </Border>

      <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True"
                   IsVisible="{Binding IsLoading}" Margin="34,0,34,8" />

      <Border DockPanel.Dock="Bottom" Padding="34,10" IsVisible="{Binding HasStatus}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding Status}" Classes="dim" FontSize="13" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Retry" FontSize="12" Padding="10,4"
                  Command="{Binding RetryCommand}" />
        </Grid>
      </Border>

      <Border DockPanel.Dock="Top" Margin="34,0,34,10" IsVisible="{Binding HasSearchMeta}">
        <StackPanel Spacing="6">
          <TextBlock Text="Blogs" Classes="dim" FontSize="11" />
          <ItemsControl ItemsSource="{Binding SearchBlogs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BlogRowViewModel">
                <Button Command="{Binding OpenCommand}" Background="#1B1B1B" CornerRadius="8"
                        Padding="8" Margin="0,0,8,8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Width="28" Height="28" CornerRadius="14" ClipToBounds="True" Background="#25323D">
                      <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Handle}" Classes="dim" FontSize="11" />
                    </StackPanel>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Button DockPanel.Dock="Bottom" Content="Load more posts" Command="{Binding LoadMoreCommand}"
              IsVisible="{Binding HasMore}" HorizontalAlignment="Center" Margin="0,6,0,10" />

      <Grid>
        <ListBox Name="FeedList" Classes="feed" ItemsSource="{Binding Posts}"
                 IsVisible="{Binding ShowFeed}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 DoubleTapped="OnOpenPost">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PostItemViewModel">
              <Border Classes="card" Margin="12,0" MaxWidth="640">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Width="40" Height="40" CornerRadius="20" ClipToBounds="True"
                            Background="#25323D" VerticalAlignment="Top">
                      <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="1">
                      <Button Content="{Binding BlogName}" Command="{Binding OpenBlogCommand}"
                              Background="Transparent" Padding="0" HorizontalAlignment="Left"
                              FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextBrush}" />
                      <TextBlock Text="{Binding Handle}" Classes="dim" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="{Binding TimeAgo}" Classes="dim" FontSize="12" VerticalAlignment="Center" />
                      <Button Content="⋯" Background="Transparent" Padding="6,0" FontSize="16"
                              Foreground="#9AA7B4" VerticalAlignment="Center">
                        <Button.Flyout>
                          <MenuFlyout>
                            <MenuItem Header="Publish now" Click="OnPublishDraft"
                                    IsVisible="{Binding CanPublishDraft}" />
                          <MenuItem Header="Move up" Click="OnMoveUp"
                                    IsVisible="{Binding CanReorder}" />
                          <MenuItem Header="Move down" Click="OnMoveDown"
                                    IsVisible="{Binding CanReorder}" />
                          <MenuItem Header="Edit post" Click="OnEditPost"
                                    IsVisible="{Binding IsMine}" />
                          <MenuItem Header="Mute post" Click="OnMutePost" />
                            <MenuItem Header="Block blog" Click="OnBlockBlog" />
                            <MenuItem Header="Report post" Click="OnReportPost" />
                            <Separator />
                            <MenuItem Header="Delete post" Click="OnDeletePost"
                                    IsVisible="{Binding !CanPublishDraft}" />
                          <MenuItem Header="Delete draft" Click="OnDeletePost"
                                    IsVisible="{Binding CanPublishDraft}" />
                          </MenuFlyout>
                        </Button.Flyout>
                      </Button>
                    </StackPanel>
                  </Grid>
  
                  <TextBlock Text="{Binding RebloggedFrom}" Classes="dim" FontSize="12"
                             IsVisible="{Binding HasReblogLabel}" />
                  <controls:PostBody Paragraphs="{Binding Paragraphs}" IsVisible="{Binding HasBody}" />
  
                  <Border IsVisible="{Binding SingleMedia}" CornerRadius="8" ClipToBounds="True" Background="#0F0F0F">
                    <Grid>
                      <Image Source="{Binding Media[0].Bitmap}" Stretch="Uniform"
                             MaxHeight="{Binding Media[0].Height}" />
                      <Border Background="#CC000000" CornerRadius="4" Padding="8,4" Margin="10"
                              HorizontalAlignment="Left" VerticalAlignment="Bottom"
                              IsVisible="{Binding Media[0].HasBadge}">
                        <TextBlock Text="{Binding Media[0].Badge}" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                      </Border>
                    </Grid>
                  </Border>
  
                  <ItemsControl ItemsSource="{Binding Media}" IsVisible="{Binding MultipleMedia}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MediaItemViewModel">
                        <Border CornerRadius="6" ClipToBounds="True" Margin="0,0,4,4" Background="#0F0F0F">
                          <Image Source="{Binding Bitmap}" Stretch="UniformToFill" Height="{Binding Height}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
  
                  <TextBlock Text="{Binding TagsText}" Classes="tag" FontSize="13" IsVisible="{Binding HasTags}" />
  
                  <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="0,5,0,0">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                      <Button Classes="postAction" Content="{Binding NotesLabel}" Click="OnOpenNotes"
                              HorizontalAlignment="Left" />
                      <Button Grid.Column="1" Classes="postAction" Command="{Binding ToggleLikeCommand}"
                              AutomationProperties.Name="Toggle like" ToolTip.Tip="Toggle like">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <TextBlock Text="{Binding LikeGlyph}" FontSize="17" />
                          <TextBlock Text="{Binding LikeCountLabel}" Classes="dim" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button Grid.Column="2" Classes="postAction" Click="OnReblog"
                              AutomationProperties.Name="Reblog" ToolTip.Tip="Reblog">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <TextBlock Text="⇄" FontSize="17" />
                          <TextBlock Text="{Binding ReblogLabel}" Classes="dim" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button Grid.Column="3" Classes="postAction" Classes.saved="{Binding IsBookmarked}"
                              Content="{Binding BookmarkGlyph}" FontSize="17" Click="OnToggleBookmark"
                              AutomationProperties.Name="{Binding BookmarkActionLabel}"
                              ToolTip.Tip="{Binding BookmarkActionLabel}" />
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
  
        <ScrollViewer Name="NotificationsScroll" IsVisible="{Binding IsNotificationsPage}" Padding="34,0,34,24"
                      ScrollChanged="OnNotificationsScroll">
          <StackPanel Spacing="2" MaxWidth="640">
            <ItemsControl ItemsSource="{Binding Notifications}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NotificationItemViewModel">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,4" Height="54">
                    <Border Width="34" Height="34" CornerRadius="17" ClipToBounds="True" Background="#25323D"
                            VerticalAlignment="Center">
                      <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" />
                      <TextBlock Text="{Binding Action}" Classes="dim" FontSize="12" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding TimeAgo}" Classes="dim" FontSize="12"
                               Margin="0,0,10,0" VerticalAlignment="Center" />
                    <Button Grid.Column="3" Content="Follow back" FontSize="12" Padding="10,5"
                            IsVisible="{Binding NeedsFollowBack}" Command="{Binding FollowBackCommand}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Load more" Command="{Binding LoadMoreNotificationsCommand}"
                    IsVisible="{Binding HasMoreNotifications}" HorizontalAlignment="Center"
                    Margin="0,12,0,20" />
          </StackPanel>
        </ScrollViewer>
  
        <ScrollViewer IsVisible="{Binding IsBookmarksPage}" Padding="34,0,34,24">
          <StackPanel Spacing="2" MaxWidth="640">
            <ItemsControl ItemsSource="{Binding Bookmarks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Click="OnOpenBookmark" Background="Transparent" Padding="10"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding BlogName}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{Binding Summary}" Classes="dim" FontSize="12"
                                   TextTrimming="CharacterEllipsis" MaxLines="2" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding SavedLabel}" Classes="dim"
                                 FontSize="11" VerticalAlignment="Top" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Nothing saved yet — tap ☆ on any post." Classes="dim" FontSize="12"
                       Margin="10,12,0,0" IsVisible="{Binding !HasBookmarks}" />
          </StackPanel>
        </ScrollViewer>

        <!-- conversations list -->
        <ScrollViewer IsVisible="{Binding IsMessagesPage}" Padding="34,0,34,24">
          <StackPanel Spacing="2" MaxWidth="640">
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !InThread}" Margin="0,0,0,10">
            <Button Content="Inbox" Classes="chip" FontSize="13" Command="{Binding ShowInboxCommand}" />
            <Button Content="Requests" Classes="chip" FontSize="13" Command="{Binding ShowRequestsCommand}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding InThread}" Margin="0,0,0,10">
              <Button Content="‹ Back" Command="{Binding BackToConversationsCommand}" />
              <TextBlock Text="{Binding ThreadTitle}" Classes="heading" VerticalAlignment="Center" />
            </StackPanel>
  
            <ItemsControl ItemsSource="{Binding Conversations}" IsVisible="{Binding !InThread}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ConversationItemViewModel">
                  <Button Command="{Binding OpenCommand}" Background="Transparent" Padding="8"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Width="44" Height="44" CornerRadius="22" Background="#25323D">
                        <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontSize="17" FontWeight="Bold" />
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{Binding Preview}" Classes="dim" FontSize="12"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="{Binding UpdatedLabel}" Classes="dim" FontSize="11"
                                   HorizontalAlignment="Right" />
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="6,1"
                                IsVisible="{Binding HasUnread}" HorizontalAlignment="Right">
                          <TextBlock Text="{Binding Conversation.Unread}" FontSize="10" Foreground="#001935" />
                        </Border>
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
  
            <ScrollViewer IsVisible="{Binding InThread}" Height="600">
              <ItemsControl ItemsSource="{Binding ThreadMessages}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MessageItemViewModel">
                    <Border Classes="card" Padding="12" Margin="0,0,0,8"
                            HorizontalAlignment="{Binding IsMine, Converter={StaticResource AlignConverter}}">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Author}" Classes="dim" FontSize="11" />
                        <TextBlock Text="{Binding Text}" FontSize="14" />
                        <TextBlock Text="{Binding TimeLabel}" Classes="dim" FontSize="10" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
  
            <Grid IsVisible="{Binding InThread}" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,10,0,0">
              <TextBox Grid.Column="0" Text="{Binding ComposerText}" PlaceholderText="Write a message…" />
              <Button Grid.Column="1" Classes="accent" Content="Send"
                      Command="{Binding SendMessageCommand}" IsEnabled="{Binding !IsSending}" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </DockPanel>

    <!-- discovery rail -->
    <Border Name="DiscoveryRail" Grid.Column="2" Background="{DynamicResource RailBrush}" Padding="20">
      <StackPanel Spacing="16">
        <TextBlock Text="Trending tags" Classes="heading" />
        <WrapPanel Orientation="Horizontal">
          <ItemsControl ItemsSource="{Binding TrendingTags}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="chip" Content="{Binding}" Margin="0,0,6,6" Click="OnTrendingTag" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </WrapPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
