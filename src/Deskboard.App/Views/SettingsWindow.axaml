<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Deskboard.App.ViewModels"
        x:Class="Deskboard.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings" Width="620" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBrush}">
  <DockPanel Margin="22">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
      <TextBlock Text="Settings" Classes="heading" />
      <Button Grid.Column="1" Content="Close" Command="{Binding CloseCommand}" />
    </Grid>

    <ScrollViewer>
      <StackPanel Spacing="18">
        <Border Classes="card" Padding="16">
          <StackPanel Spacing="6">
            <TextBlock Text="Account" FontWeight="Bold" FontSize="15" />
            <TextBlock Text="{Binding Identity}" FontSize="14" />
            <TextBlock Text="{Binding SessionState}" Classes="dim" FontSize="12" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
              <Button Content="Sign in with email…" Click="OnSignIn" />
              <Button Content="Sign out" Command="{Binding SignOutCommand}" />
              <Button Content="Re-import session from Firefox" Command="{Binding ReimportSessionCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" Classes="dim" FontSize="12" IsVisible="{Binding HasStatus}" />
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="16">
          <StackPanel Spacing="6">
            <TextBlock Text="Blogs" FontWeight="Bold" FontSize="15" />
            <TextBlock Text="Posts are published to the blog selected in the composer."
                       Classes="dim" FontSize="12" />
            <ItemsControl ItemsSource="{Binding Blogs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" FontSize="13" Margin="0,2,0,0" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="16">
          <StackPanel Spacing="8">
            <TextBlock Text="Keyword filters" FontWeight="Bold" FontSize="15" />
            <TextBlock Text="Posts containing these words (text or tags) are hidden in feeds."
                       Classes="dim" FontSize="12" TextWrapping="Wrap" />
            <CheckBox Content="Filters enabled" IsChecked="{Binding FiltersEnabled}" />
            <CheckBox Content="Hide mature (18+) blogs from feeds" IsChecked="{Binding HideAdult}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0" Text="{Binding NewMutedWord}" Watermark="word or phrase" />
              <Button Grid.Column="1" Content="Add" Command="{Binding AddMutedWordCommand}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding MutedWords}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                    <TextBlock Text="{Binding}" FontSize="13" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="✕" FontSize="11" Padding="6,0"
                            Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).RemoveMutedWordCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="16">
          <StackPanel Spacing="8">
            <TextBlock Text="Appearance" FontWeight="Bold" FontSize="15" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Dark" Classes="chip" Click="OnDark" IsVisible="{Binding IsDark}" />
              <Button Content="Light" Classes="chip" Command="{Binding SetThemeCommand}" CommandParameter="light" />
            </StackPanel>
            <TextBlock Text="Dark follows Tumblr's desktop UI palette; Light is the white-rail variant."
                       Classes="dim" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="16">
          <StackPanel Spacing="4">
            <TextBlock Text="About" FontWeight="Bold" FontSize="15" />
            <TextBlock Text="Deskboard Native — early cross-platform rewrite (.NET 10 + Avalonia)."
                       Classes="dim" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="github.com/Wrecht-Dev/deskboard-native" Classes="tag" FontSize="12" />
            <TextBlock Text="The Linux GTK proof of concept documents the API surface."
                       Classes="dim" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
