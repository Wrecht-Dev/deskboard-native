<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Deskboard.App.ViewModels"
        x:Class="Deskboard.App.Views.ComposerWindow"
        x:DataType="vm:ComposerViewModel"
        Title="New post" Width="680" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBrush}">
  <DockPanel Margin="20">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <TextBlock Text="{Binding WindowTitle}" Classes="heading" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding Blogs}" SelectedItem="{Binding SelectedBlog}"
                MinWidth="200" />
    </Grid>

    <Grid DockPanel.Dock="Bottom" RowDefinitions="Auto,Auto" Margin="0,10,0,0">
      <TextBlock Grid.Row="0" Text="{Binding Status}" Classes="dim" FontSize="12"
                 IsVisible="{Binding HasStatus}" Margin="0,0,0,8" />
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
        <Button Content="Add image" Click="OnAttach" />
        <TextBlock Text="{Binding CharacterLabel}" Classes="dim" FontSize="12" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsNew}">
          <Button Content="Schedule" Command="{Binding ToggleScheduleCommand}" />
          <Button Content="Save draft" Command="{Binding DraftCommand}" IsEnabled="{Binding CanSubmit}" />
          <Button Content="Queue" Command="{Binding QueueCommand}" IsEnabled="{Binding CanSubmit}" />
          <Button Classes="accent" Content="Publish" Command="{Binding PublishCommand}" IsEnabled="{Binding CanSubmit}" />
        </StackPanel>
        <Button Classes="accent" Content="Submit" IsVisible="{Binding IsSubmit}"
                Command="{Binding SaveCommand}" IsEnabled="{Binding CanSubmit}" />
        <Button Classes="accent" Content="Save" IsVisible="{Binding IsEdit}"
                Command="{Binding SaveCommand}" IsEnabled="{Binding CanSubmit}" />
      </StackPanel>
    </Grid>

    <StackPanel DockPanel.Dock="Bottom" IsVisible="{Binding ShowSchedule}" Spacing="6" Margin="0,8,0,0">
      <TextBlock Text="Publish at" Classes="dim" FontSize="12" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <DatePicker SelectedDate="{Binding PublishAt}" />
        <TimePicker SelectedTime="{Binding PublishAt}" />
        <Button Classes="accent" Content="Schedule" Command="{Binding ScheduleCommand}" />
      </StackPanel>
    </StackPanel>

    <StackPanel Spacing="10">
      <TextBox Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap" Height="240"
               Watermark="What's on your mind?" />
      <TextBox Text="{Binding Tags}" Watermark="tags: comma, separated" />
      <ItemsControl ItemsSource="{Binding Images}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ComposerViewModel">
            <TextBlock Text="image attached" Classes="dim" FontSize="12" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </DockPanel>
</Window>
