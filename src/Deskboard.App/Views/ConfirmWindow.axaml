<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Deskboard.App.Views.ConfirmWindow"
        Title="Confirm" Width="420" Height="180"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBrush}">
  <StackPanel Margin="22" Spacing="16">
    <TextBlock Name="MessageText" TextWrapping="Wrap" FontSize="14" />
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <Button Grid.Column="1" Content="Cancel" Click="OnCancel" />
      <Button Grid.Column="2" Classes="accent" Name="ConfirmButton" Content="Confirm" Click="OnConfirm" />
    </Grid>
  </StackPanel>
</Window>
